    <label>§ 34 Abs. 2 MessEV</label>
    <protected>false</protected>
    <values>
        <field>Norm__c</field>
        <value xsi:type="xsd:string">§ 34 Abs. 2 MessEV</value>
    </values>
    <values>
        <field>Gesetz__c</field>
        <value xsi:type="xsd:string">MessEV</value>
    </values>
    <values>
        <field>Wortlaut__c</field>
        <value xsi:type="xsd:string">endet diese bei Eichfristen, die mindestens ein Jahr betragen, erst mit dem Ende des Jahres, in dem die Frist rechnerisch endet.</value>
    </values>
    <values>
        <field>Quelle_URL__c</field>
        <value xsi:type="xsd:string">https://www.gesetze-im-internet.de/messev/__34.html</value>
    </values>
    <values>
        <field>Gueltig_von__c</field>
        <value xsi:type="xsd:date">2015-01-01</value>
    </values>
    <values>
        <field>Parameter_Wert__c</field>
        <value xsi:type="xsd:double">1</value>
    </values>
    <values>
        <field>Parameter_Einheit__c</field>
        <value xsi:type="xsd:string">Jahr</value>
    </values>
    <values>
        <field>Hinweis__c</field>
        <value xsi:type="xsd:string">Die Bedingung "mindestens ein Jahr" ist keine Formalie. Kürzere Fristen fallen unter Abs. 3 und enden zum Monatsende. Beide Absätze schließen zudem mit einer Vermutung über das Jahr des Inverkehrbringens anhand der Kennzeichnung nach § 14 — das Gesetz liefert also einen Ersatz für das fehlende Datum, den der Korpus noch nicht abbildet.</value>
    </values>
