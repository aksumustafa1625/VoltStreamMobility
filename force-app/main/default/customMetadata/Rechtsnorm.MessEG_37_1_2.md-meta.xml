    <label>§ 37 Abs. 1 Satz 2 MessEG</label>
    <protected>false</protected>
    <values>
        <field>Norm__c</field>
        <value xsi:type="xsd:string">§ 37 Abs. 1 Satz 2 MessEG</value>
    </values>
    <values>
        <field>Gesetz__c</field>
        <value xsi:type="xsd:string">MessEG</value>
    </values>
    <values>
        <field>Wortlaut__c</field>
        <value xsi:type="xsd:string">Für Messgeräte, die nach den Vorschriften des Abschnitts 2 in Verkehr gebracht wurden, beginnt die Eichfrist mit dem Inverkehrbringen.</value>
    </values>
    <values>
        <field>Quelle_URL__c</field>
        <value xsi:type="xsd:string">https://www.gesetze-im-internet.de/messeg/__37.html</value>
    </values>
    <values>
        <field>Gueltig_von__c</field>
        <value xsi:type="xsd:date">2015-01-01</value>
    </values>
    <values>
        <field>Hinweis__c</field>
        <value xsi:type="xsd:string">Gilt nur für die ERSTE Eichfrist. Nach jeder Nacheichung übernimmt § 34 Abs. 1 MessEV mit einem anderen Fristbeginn. Ein Modell, das nur das Inverkehrbringen speichert, rechnet für jeden nachgeeichten Ladepunkt der Flotte falsch.</value>
    </values>
